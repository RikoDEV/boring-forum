# The settings a production server needs. Everything else is optional: see .env.example.
# Docker Compose (deploy/compose.yml) reads this file as .env, beside the compose file.

# The address people will use. https, no trailing path.
BF_BASE_URL=https://forum.example.com

# Encrypts two-factor and webhook secrets. An https site refuses to start without it.
# Make one with: docker compose run --rm server secret-key
# Keep a copy apart from the database backups; a restore is unreadable without it.
BF_SECRET_KEY=

# Postgres in Docker Compose. Read when the database volume is first created: changing them later does
# not rename or re-key an existing database. Use letters and digits in passwords (they are also put
# into the server's database address), or percent-encode them.
POSTGRES_USER=forum
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=forum

# The server's own database roles, created automatically on every start. Change the passwords.
BF_APP_DB_PASSWORD=CHANGE_ME
BF_MIGRATE_DB_PASSWORD=CHANGE_ME
BF_READONLY_DB_PASSWORD=CHANGE_ME

# --- Recommended -----------------------------------------------------------------
# The address of your reverse proxy, as the server sees it (single addresses, not networks; comma
# separated). Without it every visitor shares the proxy's address, so rate limits and login lockouts
# treat everyone as one and HTTPS redirects never happen. A proxy on the Docker host usually shows up
# as the bridge gateway: check with `docker network inspect <project>_default`.
# BF_TRUSTED_PROXIES=172.17.0.1

# Outgoing mail: sign-up confirmation, password resets and notifications. Set both.
# BF_SMTP_URL=smtps://user:password@smtp.example.com:465
# BF_MAIL_FROM=Forum <noreply@example.com>

# Docker Compose: the release to run. Default is the newest.
# BF_VERSION=0.0.3

# --- Optional --------------------------------------------------------------------
# Bearer token for the admin API, 32 characters or more.
# BF_ADMIN_TOKEN=
# Behind Cloudflare: headers carrying the visitor's country and network number.
# BF_GEO_HEADER=CF-IPCountry
# BF_ASN_HEADER=CF-IPASN
