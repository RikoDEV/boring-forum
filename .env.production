# The settings a production server needs. Everything else is optional: see .env.example.
# Docker Compose (deploy/compose.yml) reads this file as .env, beside the compose file.

# The address people will use. https, no trailing path.
BF_BASE_URL=https://forum.example.com

# Encrypts two-factor and webhook secrets. An https site refuses to start without it.
# Make one with: docker compose run --rm server secret-key
# Keep a copy apart from the database backups; a restore is unreadable without it.
BF_SECRET_KEY=

# Postgres connection. Docker Compose sets this itself, so it matters only outside Compose.
BF_DATABASE_URL=postgres://forum:CHANGE_ME@127.0.0.1:5432/forum
