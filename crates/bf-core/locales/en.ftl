# Emails. Each mail is two messages, its subject and its body; an administrator rewrites one
# in Site text like any other text, one language at a time.
mail-verify-subject = Confirm your email for { $site }
mail-verify-body =
    Hi { $username },

    Confirm your email address by opening this link within 24 hours:

    { $link }

    If you did not ask for this, ignore this email.

    — { $site }
mail-reset-subject = Reset your { $site } password
mail-reset-body =
    Hi { $username },

    Someone asked to reset your password. If it was you, open this link within 1 hour:

    { $link }

    If you did not ask for this, ignore this email.

    — { $site }
mail-notification-subject = { $by } posted in “{ $title }” - { $site }
mail-notification-body =
    { $by } posted in “{ $title }”:

    { $link }

    Change which emails you get under Account settings.

    — { $site }
mail-security-subject = { $what } - { $site }
mail-security-body =
    Hi { $username },

    { $what }.

    If this was you, there is nothing to do. If it was not, reset your password at { $link } and contact the staff.

    — { $site }
mail-backup-subject = Download link for a { $site } backup
mail-backup-body =
    Hi { $username },

    You asked to download the backup { $name }. Open this link while you are signed in as an administrator. It works once, within 15 minutes:

    { $link }

    If you did not ask for this, ignore this email and look at the staff log.

    — { $site }
mail-digest-subject = New on { $site }
mail-digest-body =
    Hi { $username },

    { $topics }
    Change or turn off digests under Account settings.
    Unsubscribe from digests: { $unsubscribe }

    — { $site }

