BF_DATABASE_URL=postgres://forum:forum@127.0.0.1:5432/forum
BF_BIND=127.0.0.1:8080
# At least 32 characters; admin API is disabled when unset.
BF_ADMIN_TOKEN=
BF_MICROCACHE_TTL_MS=2000
BF_RATE_LIMIT_PER_MIN=600
BF_LOG_JSON=false
# Trusted CDN header holding the network operator number, for ASN bans, e.g. CF-IPASN.
BF_ASN_HEADER=
# Trusted CDN header with the visitor's country, shown in the session list, e.g. CF-IPCountry.
BF_GEO_HEADER=
# Ed25519 keys (hex, comma separated) trusted to sign plugins.
BF_PLUGIN_PUBLIC_KEYS=
# At least 32 characters; enables POST /api/v1/webhooks/bounce for the mail provider.
BF_BOUNCE_TOKEN=

# --- Encryption at rest --------------------------------------------------------
# Encrypts TOTP and webhook secrets in the database. `boring-forum secret-key` prints one.
# Without it those columns hold plain text and the server warns at startup. Keep it out of the
# database and out of the backups; see docs/configuration.md for how to rotate it.
BF_SECRET_KEY=
# Retired keys, comma separated. Set during a rotation so old rows stay readable, then remove.
BF_SECRET_KEY_OLD=
# An https site refuses to start without BF_SECRET_KEY; set 1 to run without it anyway.
# BF_ALLOW_NO_SECRET_KEY=1

# --- HTTPS ---------------------------------------------------------------------
# Set both to terminate TLS in the server itself (rustls: TLS 1.2 and 1.3 only). Leave empty
# behind a reverse proxy that terminates TLS, and make sure it sends X-Forwarded-Proto.
BF_TLS_CERT=
BF_TLS_KEY=
# With TLS enabled, an extra plain-HTTP listener that only redirects, e.g. 0.0.0.0:80.
BF_HTTP_BIND=
# off | proxied | always. Default: always with TLS here, proxied for an https BF_BASE_URL.
BF_HTTPS_REDIRECT=
# Adds `preload` to HSTS. Opt-in: a preload submission is effectively permanent.
BF_HSTS_PRELOAD=false

# --- Least-privilege database roles (.9; see deploy/postgres/roles.sql) ----------------------
# Migrations run as a schema-owning role, the server as one that cannot change the schema.
# BF_DATABASE_URL must NOT be a superuser: a SQL flaw would then be code execution on the DB host.
BF_MIGRATE_DATABASE_URL=
# Only for `boring-forum provision-roles` (Docker Compose runs it): a connection as the database owner,
# and the passwords it gives the three roles. The server never reads these.
BF_ADMIN_DATABASE_URL=
BF_APP_DB_PASSWORD=
BF_MIGRATE_DB_PASSWORD=
BF_READONLY_DB_PASSWORD=
BF_STATEMENT_TIMEOUT_MS=15000
# Data Explorer: a connection that logs in AS the restricted bf_explorer role, which can
# read only the explorer.* views. Required for the Explorer; unset keeps it off. Never point this
# at forum_app or a superuser. Provision the role with deploy/postgres/explorer-role.sql.
BF_EXPLORER_DATABASE_URL=

# --- Audit log forwarding ------------------------------------------------------
# Write each security event to the `audit` tracing target (one JSON line with BF_LOG_JSON=true).
BF_AUDIT_SINK_STDOUT=false
# Or POST batches as newline-delimited JSON to an external log system.
BF_AUDIT_SINK_URL=
# 32+ characters; signs each batch as t=<unix>,sha256=<hex> in x-bf-signature.
BF_AUDIT_SINK_SECRET=
BF_AUDIT_SINK_TOKEN=

# --- Backups ------------------------------------------------------------------------------
# Where backup archives are kept (Admin, Backups). Default data/backups; /data/backups in the image.
# BF_BACKUP_DIR=data/backups

RUST_LOG=info,sqlx=warn

# --- modern standards -------------------------------------------------------------
# /metrics answers this bearer token (16+ characters); unset, only loopback may scrape it.
BF_METRICS_TOKEN=
# OTLP/HTTP trace export, e.g. http://otel-collector:4318. The other OTEL_* variables apply.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=boring-forum
# Known illegal-image hash list (pdq:<hex> / sha256:<hex> per line), from NCMEC, IWF or the
# Tech Coalition. Not shipped with the software.
BF_IMAGE_HASHLIST=

# --- Everything else the server reads (docs/configuration.md has the full table) ---------------
# Public origin for links, feeds and sitemaps, e.g. https://forum.example
# BF_BASE_URL=
# Database pool size; default is the CPU count (at least 2).
# BF_DB_POOL_SIZE=
# Comma-separated proxy addresses or networks (172.17.0.1, 172.16.0.0/12) whose X-Forwarded-For /
# X-Forwarded-Proto are believed.
# BF_TRUSTED_PROXIES=
# Directory of the built admin panel.
# BF_ADMIN_DIR=web/admin/build
# Seconds between failing /readyz and closing listeners on shutdown.
# BF_DRAIN_SECS=5
# Maintenance interval in seconds.
# BF_TICK_SECONDS=600
# Days between a deletion request and the account being anonymized.
# BF_DELETE_GRACE_DAYS=14
# Uploaded files on disk.
# BF_UPLOAD_DIR=data/uploads
# Outgoing mail: an SMTP URL and the sender, or a directory for development (mail written as files).
# BF_SMTP_URL=
# BF_MAIL_FROM=
# BF_MAIL_DIR=
# Reply by email and the inbound mail webhook (32+ character token).
# BF_REPLY_DOMAIN=
# BF_INBOUND_TOKEN=
# Registration challenge: override of the verification endpoint (tests).
# BF_CAPTCHA_VERIFY_URL=
# Generic OpenID Connect provider; set all but the name.
# Apple endpoint override (tests).
# BF_OAUTH_APPLE_BASE=
# AI provider keys (the AI settings in the admin panel hold the rest); these win over the stored ones.
# BF_AI_API_KEY=
# BF_AI_EMBEDDING_API_KEY=
# Mailchimp newsletter sync (key ends in -dc).
# BF_MAILCHIMP_API_KEY=
# Web push: `boring-forum vapid` makes the key; the subject is a mailto: or site address.
# BF_VAPID_PRIVATE=
# BF_VAPID_SUBJECT=
# Tests only. Never set these in production.
# BF_TIME_SCALE_PERCENT=100
# BF_WEBHOOK_ALLOW_LOOPBACK=
# Several nodes: share live updates and cache clears over Postgres.
# BF_CLUSTER=1
# Reply by email over IMAP (TLS) instead of the /inbound webhook.
# BF_IMAP_HOST=
# BF_IMAP_PORT=993
# BF_IMAP_USER=
# BF_IMAP_PASSWORD=
# BF_IMAP_INTERVAL_SECS=60
# AI: mock answers without a network; allow a private address (local Ollama).
# BF_AI_PROVIDER=mock
# BF_AI_ALLOW_PRIVATE=1
# Importer: the folder holding the export's uploads, and 1 to let guests read every imported forum.
# BF_IMPORT_FILES=/path/to/uploads
# BF_IMPORT_PUBLIC=1
# Importer: 0 skips plugin hooks.
# BF_IMPORT_PLUGINS=0
# Registrations per address per hour (default 10). Raise only for tests.
# BF_REGISTER_LIMIT_PER_HOUR=10

# Docker Compose only: the release to run (default: the newest), e.g. 0.0.1.
# BF_VERSION=
